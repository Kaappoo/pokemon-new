# Base URL of the deployed Go backend's API, including the /api suffix.
# Read at build time by Vite (must be prefixed with VITE_ to reach the
# browser bundle). Defaults to http://localhost:8080/api for local dev if
# unset - in production this MUST be set to your deployed backend's public
# HTTPS URL, or login/wishlist/collection calls will try to reach
# "localhost" on the visitor's own device and fail.
VITE_API_BASE_URL=https://your-backend-host.example.com/api
