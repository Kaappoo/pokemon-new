# Public URL of the app (used for Open Graph images and auth callbacks).
APP_URL=http://localhost:3000

# Neon Postgres. Leave empty locally to use an in-process Postgres (PGlite)
# stored in ./.pglite. On Vercel set the pooled connection string here.
DATABASE_URL=
# Direct (non-pooled) connection string for migrations and the catalog sync,
# which write concurrently. Falls back to DATABASE_URL. Vercel's Neon
# integration sets this for you.
DATABASE_URL_UNPOOLED=

# better-auth — generate with `openssl rand -base64 32`
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# Resend (magic links + password reset). Leave empty to log emails to the console.
RESEND_API_KEY=
EMAIL_FROM="Poké Cards <cards@example.com>"
